<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuCombustivel.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_car.png"
                HeightRequest="200"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label Text="Preço do Etanol:" />
            <Entry x:Name="txt_etanol"
                Placeholder="R$"
                Keyboard="Numeric" />

            <Label Text="Preço da Gasolina:" />
            <Entry x:Name="txt_gasolina"
                Placeholder="R$"
                Keyboard="Numeric" />

            <Label Text="Marca do Veículo:" />
            <Entry x:Name="txt_marca"
                Placeholder="Ex: Fiat, Chevrolet, etc."
                Keyboard="Text" />

            <Label Text="Modelo do Veículo:" />
            <Entry x:Name="txt_modelo"
                Placeholder="Ex: Uno Fire, Onix, etc."
                Keyboard="Text" />

            <Button Text="Qual compensa mais?" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
